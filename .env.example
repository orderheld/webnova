# Neon Postgres (Vercel → Storage → Neon, oder neon.tech). Pooled connection string.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Resend (resend.com) – Domain webnova.ch verifizieren, dann API-Key erstellen
RESEND_API_KEY=re_xxx
RESEND_FROM="Webnova <kontakt@webnova.ch>"
# Wohin neue Anfragen gemeldet werden (Standard: kontakt@webnova.ch)
LEAD_INBOX=kontakt@webnova.ch

# Admin-Login (/admin)
ADMIN_EMAIL=ferhat@webnova.ch
ADMIN_PASSWORD=ein-langes-sicheres-passwort
# Zufälliger String, min. 32 Zeichen: openssl rand -base64 32
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=https://webnova.ch
